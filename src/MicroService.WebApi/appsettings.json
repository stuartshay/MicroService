{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://coredatastore.com",
      "https://coredatastore-ui-w6zlqlyoma-uk.a.run.app",
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:2000"
    ]
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "MicroService.WebApi Health Checks",
        "Uri": "http://localhost:5000/health"
      }
    ],
    "EvaluationTimeinSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "ShapeConfiguration": {
    "ShapeRootDirectory": "../../files",
    "CronExpression": "*/1 * * * *"
  },
  "GrafanaLokiConfiguration": {
    "Uri": "http://loki:3100",
    "Enabled": false
  },
  "JaegerConfiguration": {
    "Enabled": false
  },
  "HealthCheckConfiguration": {
    "HealthCheckJson": "/healthz"
  }
}


